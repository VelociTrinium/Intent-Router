# Environment Variables for Intent Router
# Copy this file to .env and fill in your actual credentials.

# Gemini API Key (Required for synthetic data generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Token (Optional: required for pushing exported GGUF models to Hugging Face Hub)
HF_TOKEN=your_hf_token_here

# Routing Thresholds
CONFIDENCE_THRESHOLD=0.60
WRITE_THRESHOLD=0.40
CLARIFY_THRESHOLD=0.40
FALLBACK_ROUTE=CLARIFICATION_REQUIRED

# Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=intent-router-qwen2.5-0.5b-instruct:v1

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
